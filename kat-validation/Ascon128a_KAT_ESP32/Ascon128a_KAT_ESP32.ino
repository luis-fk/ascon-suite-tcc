#define NUM_VECTORS (sizeof(vectors) / sizeof(vectors[0]))

static TestVector tv;
static uint8_t outbuf[MAX_PT + 16];
static uint8_t ptbuf[MAX_PT];

static bool runVector(const TestVector *t)
{
  size_t clen = 0, mlen = 0;

  // (1) Cifra e compara com o (ciphertext || tag) esperado.
  ascon128a_aead_encrypt(outbuf, &clen,
                         t->pt, t->ptlen,
                         t->ad, t->adlen,
                         t->nonce, t->key);
  if (clen != t->ctlen || memcmp(outbuf, t->ct, t->ctlen) != 0)
    return false;

  // (2) Decifra o valor esperado e confirma texto claro + tag valida.
  int r = ascon128a_aead_decrypt(ptbuf, &mlen,
                                 t->ct, t->ctlen,
                                 t->ad, t->adlen,
                                 t->nonce, t->key);
  if (r < 0 || mlen != t->ptlen)
    return false;
  if (t->ptlen && memcmp(ptbuf, t->pt, t->ptlen) != 0)
    return false;

  return true;
}

void setup()
{
  Serial.begin(115200);
  delay(300);

  Serial.println();
  Serial.println("=== Ascon-128a KAT (on-device, ESP32) ===");
  Serial.print("Estado incremental (bytes): ");
  Serial.println((unsigned) sizeof(ascon128a_state_t));
  Serial.println();

  int passed = 0;
  for (size_t i = 0; i < NUM_VECTORS; i++) {
    memcpy_P(&tv, &vectors[i], sizeof(TestVector));

    Serial.print(tv.name);
    Serial.print(" ... ");

    if (runVector(&tv)) { 
      Serial.println("OK"); 
      passed++; 
    }
    else                  
      Serial.println("FALHOU");
  }

  Serial.println();
  Serial.print("Resultado: ");
  Serial.print(passed);
  Serial.print("/");
  Serial.print((int) NUM_VECTORS);
  Serial.println(" vetores passaram.");

  if (passed == (int) NUM_VECTORS)
    Serial.println(">>> TODOS OS VETORES PASSARAM NA PLACA <<<");
  else
    Serial.println(">>> FALHA: divergencia na placa <<<");
}

void loop()
{
  // O teste roda uma vez no setup(). Um loop() vazio fica em "busy-spin" no
  // ESP32: satura um nucleo da CPU e impede a tarefa ociosa de rodar, o que
  // dispara o watchdog, que inunda a Serial e trava o Monitor Serial.
  // O delay() cede o processador e elimina esse comportamento.
  delay(1000);
}
